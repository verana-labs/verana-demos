# =============================================================================
# Issuer Chatbot VS — Configuration
# =============================================================================
#
# This file is read by the setup scripts and GHA workflow.
# It contains all configuration needed for the Issuer Chatbot child service.
#
# For local testing:
#   source issuer-chatbot-vs/config.env
#   ./issuer-chatbot-vs/scripts/setup.sh
#
# =============================================================================

# ---------------------------------------------------------------------------
# Network (derived from branch name in GHA; set manually for local usage)
# ---------------------------------------------------------------------------
# NETWORK="devnet"

# ---------------------------------------------------------------------------
# Veranad CLI account name — also this agent's own on-chain identity
# (VERANA_ACCOUNT_MNEMONIC in deployment.yaml is the same mnemonic).
# ---------------------------------------------------------------------------
USER_ACC="issuer-chatbot-vs-devnet-admin"

# ---------------------------------------------------------------------------
# issuer-chatbot-vs's own Corporation (verana.co.v1). Empty until the
# "bootstrap-corporation" step runs once — see scripts/setup.sh.
# ---------------------------------------------------------------------------
CORPORATION_ID=""

# ---------------------------------------------------------------------------
# Organization VS — parent service
# Set to the public URL of the organization-vs agent (K8s or local). Used to
# discover the "example" schema and its root participant, and — for local
# testing — to reach its admin API for validation.
# ---------------------------------------------------------------------------
ORG_VS_PUBLIC_URL="${ORG_VS_PUBLIC_URL:-}"
ORG_VS_PUBLIC_URL="${ORG_VS_PUBLIC_URL%/}"
ORG_VS_ADMIN_URL="${ORG_VS_ADMIN_URL:-http://localhost:3000}"
ORG_VS_ADMIN_URL="${ORG_VS_ADMIN_URL%/}"

# ---------------------------------------------------------------------------
# VS Agent image and ports (local development)
# Use different ports than other services to avoid collision.
# ---------------------------------------------------------------------------
VS_AGENT_IMAGE="${VS_AGENT_IMAGE:-veranalabs/vs-agent:v2.0.0-dev.17}"
VS_AGENT_CONTAINER_NAME="issuer-chatbot-vs"
VS_AGENT_ADMIN_PORT="3002"
VS_AGENT_PUBLIC_PORT="3003"

# ---------------------------------------------------------------------------
# Service details
# These appear in the Service credential, self-issued automatically by
# EcsBootstrapService's delegated flow (obtained from organization-vs).
# ---------------------------------------------------------------------------
SERVICE_NAME="Example Issuer Chatbot"
SERVICE_TYPE="MESSAGING_APP"
SERVICE_DESCRIPTION="Chatbot credential issuer for the Verana demo ecosystem"

# ---------------------------------------------------------------------------
# Custom schema base ID
# Must match the schema deployed by organization-vs.
# ---------------------------------------------------------------------------
CUSTOM_SCHEMA_BASE_ID="example"

# ---------------------------------------------------------------------------
# AnonCreds
# Set to "true" to create an AnonCreds credential definition for issuance.
# ---------------------------------------------------------------------------
ENABLE_ANONCREDS="true"
ANONCREDS_NAME="example"
ANONCREDS_VERSION="1.0"
ANONCREDS_SUPPORT_REVOCATION="false"

# ---------------------------------------------------------------------------
# Chatbot configuration
# ---------------------------------------------------------------------------
CHATBOT_PORT="4000"

# Session persistence
# Local: SQLite file path
# K8s:   PostgreSQL connection string (e.g., postgresql://user:pass@host:5432/db)
DATABASE_URL="sqlite:./data/sessions.db"

# Logging level (debug, info, warn, error)
LOG_LEVEL="info"
