# =============================================================================
# Verifier Web VS — Configuration
# =============================================================================
#
# This file is read by the setup scripts and GHA workflow.
# It contains all configuration needed for the Verifier Web child service.
#
# For local testing:
#   source verifier-web-vs/config.env
#   ./verifier-web-vs/scripts/setup.sh
#
# =============================================================================

# ---------------------------------------------------------------------------
# Network (derived from branch name in GHA; set manually for local usage)
# ---------------------------------------------------------------------------
# NETWORK="devnet"

# ---------------------------------------------------------------------------
# Veranad CLI account name — also this agent's own on-chain identity
# (VERANA_ACCOUNT_MNEMONIC in deployment.yaml is the same mnemonic).
# ---------------------------------------------------------------------------
USER_ACC="verifier-web-vs-devnet-admin"

# ---------------------------------------------------------------------------
# verifier-web-vs's own Corporation (verana.co.v1). Empty until the
# "bootstrap-corporation" step runs once — see scripts/setup.sh.
# ---------------------------------------------------------------------------
CORPORATION_ID=""

# ---------------------------------------------------------------------------
# Organization VS — parent service
# Set to the public URL of the organization-vs agent (K8s or local). Used to
# discover the "example" schema and its root participant.
# ---------------------------------------------------------------------------
ORG_VS_PUBLIC_URL="${ORG_VS_PUBLIC_URL:-}"
ORG_VS_PUBLIC_URL="${ORG_VS_PUBLIC_URL%/}"
ORG_VS_ADMIN_URL="${ORG_VS_ADMIN_URL:-http://localhost:3000}"
ORG_VS_ADMIN_URL="${ORG_VS_ADMIN_URL%/}"

# ---------------------------------------------------------------------------
# VS Agent image and ports (local development)
# Use different ports than other services to avoid collision.
# ---------------------------------------------------------------------------
VS_AGENT_IMAGE="${VS_AGENT_IMAGE:-veranalabs/vs-agent:v2.0.0-dev.17}"
VS_AGENT_CONTAINER_NAME="verifier-web-vs"
VS_AGENT_ADMIN_PORT="3008"
VS_AGENT_PUBLIC_PORT="3009"

# ---------------------------------------------------------------------------
# Service details
# These appear in the Service credential, self-issued automatically by
# EcsBootstrapService's delegated flow (obtained from organization-vs).
# ---------------------------------------------------------------------------
SERVICE_NAME="Example Web Verifier"
SERVICE_TYPE="WEB_PORTAL"
SERVICE_DESCRIPTION="Web-based credential verifier for the Verana demo ecosystem"

# ---------------------------------------------------------------------------
# Custom schema base ID
# Must match the schema deployed by organization-vs.
# ---------------------------------------------------------------------------
CUSTOM_SCHEMA_BASE_ID="example"

# ---------------------------------------------------------------------------
# Issuer VS — the issuer whose credential definition this verifier targets
# Set to the public URL of the issuer-web-vs agent (K8s or local).
# ---------------------------------------------------------------------------
ISSUER_VS_PUBLIC_URL="${ISSUER_VS_PUBLIC_URL:-http://localhost:3005}"
ISSUER_VS_PUBLIC_URL="${ISSUER_VS_PUBLIC_URL%/}"

# ---------------------------------------------------------------------------
# Web verifier configuration
# ---------------------------------------------------------------------------
VERIFIER_PORT="4003"

# Logging level (debug, info, warn, error)
LOG_LEVEL="info"
