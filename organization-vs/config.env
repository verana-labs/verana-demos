# =============================================================================
# Organization VS — Configuration
# =============================================================================
#
# This file is read by the setup scripts and GHA workflow.
# It contains all configuration needed for the Organization VS service.
#
# For local testing:
#   source organization-vs/config.env
#   ./organization-vs/scripts/setup.sh
#
# =============================================================================

# ---------------------------------------------------------------------------
# Network (derived from branch name in GHA; set manually for local usage)
# ---------------------------------------------------------------------------
# NETWORK="devnet"

# ---------------------------------------------------------------------------
# Two accounts, two roles
# ---------------------------------------------------------------------------
# USER_ACC holds this Corporation's blanket OperatorAuthorization. The setup
# script signs every transaction with it, and the agent never sees it
# (mnemonic: ORGANIZATION_VS_MNEMONIC).
#
# AGENT_ACC is the agent's own and only account (mnemonic:
# ORGANIZATION_VS_AGENT_MNEMONIC, passed as VERANA_ACCOUNT_MNEMONIC). It is the
# vs_operator of the Participant entries the setup script assigns to this
# agent, and it holds no OperatorAuthorization. The chain forbids one account
# from holding both, so the two mnemonics MUST be different accounts.
# ---------------------------------------------------------------------------
USER_ACC="organization-vs-devnet-admin"
AGENT_ACC="organization-vs-devnet-agent"

# ---------------------------------------------------------------------------
# organization-vs's own Corporation (verana.co.v1). Empty until the
# "bootstrap-corporation" step runs once — see scripts/setup.sh.
# ---------------------------------------------------------------------------
CORPORATION_ID="6"

# ---------------------------------------------------------------------------
# VS Agent image and ports (local development)
# ---------------------------------------------------------------------------
VS_AGENT_IMAGE="${VS_AGENT_IMAGE:-veranalabs/vs-agent:latest}"
VS_AGENT_CONTAINER_NAME="organization-vs"
VS_AGENT_ADMIN_PORT="3000"
VS_AGENT_PUBLIC_PORT="3001"

# ---------------------------------------------------------------------------
# Expose admin API publicly (K8s only)
# When "true", the workflow deploys a standalone ingress at
# admin.organization-vs.<VS_NAME>.demos.<NETWORK>.verana.network exposing
# only Swagger UI (/api). The vt-flow admin endpoints stay private
# (kubectl port-forward only, same as verana-deploy's ecs-ecosystem).
# ---------------------------------------------------------------------------
EXPOSE_ADMIN_API="true"

# ---------------------------------------------------------------------------
# Organization details
# These are the claims of the Organization credential. The setup script puts
# them on the onboarding flow, and the ECS Organization credential issuer signs
# them. The issuer refuses claims that do not satisfy the schema, so the values
# must be real. ORG_NAME also becomes the agent's DIDComm label.
# ---------------------------------------------------------------------------
ORG_NAME="Verana Example Organization"
ORG_ORGANIZATION_KIND="PUBLIC"
ORG_COUNTRY_CODE="CH"
ORG_REGISTRY_ID="CH-CHE-123.456.789"
ORG_REGISTRY_URI="https://www.zefix.ch"
ORG_ADDRESS="Bahnhofstrasse 42, 8001 Zurich, Switzerland"
# The logo must be reachable: the script hashes its content into logoDigestSri.
ORG_LOGO_URI="https://verana.io/logo.svg"

# ---------------------------------------------------------------------------
# Service details
# These appear in the Service credential, which the agent issues to itself and
# anchors against its own ISSUER entry on the ECS Service schema
# (SELF_ISSUED_VTC_SERVICE_* env vars in deployment.yaml).
# ---------------------------------------------------------------------------
SERVICE_TYPE="WEB_PORTAL"
SERVICE_DESCRIPTION="Organization service for the Verana demo ecosystem"

# ---------------------------------------------------------------------------
# "example" ecosystem
# organization-vs runs its own small Ecosystem so issuer-*/verifier-* demo
# services have something to onboard against.
# ---------------------------------------------------------------------------

# Custom schema — read from schema.json by default.
# Override with a URL if you want to use a remote schema.
# CUSTOM_SCHEMA_URL="https://verana-labs.github.io/verifiable-trust-spec/schemas/v4/example.json"

# Base ID for the VTJSC (used in DID Document service entries)
CUSTOM_SCHEMA_BASE_ID="example"

# Ecosystem Governance Framework document
# Digest is auto-calculated at runtime if left empty.
EGF_DOC_URL="https://verana-labs.github.io/governance-docs/EGF/example.pdf"
# EGF_DOC_DIGEST=""
