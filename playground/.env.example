# Build-time (baked into client JS — user opens this URL in the browser)
NEXT_PUBLIC_ISSUER_WEB_URL=http://localhost:4001

# Runtime (server-side only — internal cluster URLs used by API route proxies)
ISSUER_CHATBOT_VS_ADMIN_URL=http://localhost:3000
VERIFIER_CHATBOT_URL=http://localhost:4002
VERIFIER_WEB_URL=http://localhost:4003

# Runtime (server-side only — live network data: service DIDs, ecosystem,
# credential schema, participant tree, and the v4 trust resolution of each
# service, all read from the indexer)
DEMOS_BASE_DOMAIN=example.demos.devnet.verana.network
VERANA_NETWORK=devnet
# Optional overrides (default to https://idx.<network>.verana.network and
# https://app.<network>.verana.network)
#INDEXER_URL=
#VERANA_FRONTEND_URL=
